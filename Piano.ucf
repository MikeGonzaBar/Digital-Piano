NET "clk" LOC = "B8" | IOSTANDARD = LVCMOS33;
NET "clk" TNM_NET = "clk";
TIMESPEC "TS_clk" = PERIOD "clk" 20 ns HIGH 50%;

NET "sw1" LOC = "E2" | IOSTANDARD = LVCMOS33;
NET "sw2" LOC = "F3" | IOSTANDARD = LVCMOS33;
NET "sw3" LOC = "G3" | IOSTANDARD = LVCMOS33;
NET "sw4" LOC = "B4" | IOSTANDARD = LVCMOS33;
NET "sw5" LOC = "K3" | IOSTANDARD = LVCMOS33;
NET "sw6" LOC = "L3" | IOSTANDARD = LVCMOS33;
NET "sw7" LOC = "P11" | IOSTANDARD = LVCMOS33;

NET "btn1" LOC = "A7" | IOSTANDARD = LVCMOS33;
NET "btn2" LOC = "M4" | IOSTANDARD = LVCMOS33;
NET "btn3" LOC = "C11" | IOSTANDARD = LVCMOS33;
NET "btn4" LOC = "G12" | IOSTANDARD = LVCMOS33;
NET "reset" LOC = "N3" | IOSTANDARD = LVCMOS33;

NET "sound" LOC = "B2" | IOSTANDARD = LVCMOS33 | DRIVE = 8 | SLEW = SLOW;
